# Copy to .env and replace every CHANGE_ME value before starting Compose.
NODE_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql://swachh:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/swachh
POSTGRES_USER=swachh
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=swachh
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
QR_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
QR_SECRET_VERSION=1
PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=apps/api/.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=swachh-track
# Signed URLs must use a hostname reachable by the collector and browser.
S3_PUBLIC_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000/api/v1
# Future adapters remain NOT_CONFIGURED even when a signature secret is present.
SWACHHATA_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
