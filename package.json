{
  "name": "swachh-track",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "concurrently -n api,web,collector 'pnpm --filter @swachh/api dev' 'pnpm --filter @swachh/web dev' 'pnpm --filter @swachh/collector start'",
    "build": "pnpm --filter @swachh/web build",
    "start:hosted-demo": "node scripts/start-hosted-demo.mjs",
    "lint": "eslint apps packages prisma scripts tests --ignore-pattern '**/.next/**'",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "check": "pnpm db:migrate && pnpm db:seed && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write apps packages prisma docs *.md *.json *.yml"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.21",
    "@types/supertest": "6.0.3",
    "concurrently": "9.1.2",
    "dotenv": "16.5.0",
    "eslint": "9.27.0",
    "prettier": "3.5.3",
    "prisma": "6.8.2",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vitest": "3.1.4"
  },
  "dependencies": { "@prisma/client": "6.8.2" },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "msgpackr-extract", "prisma", "sharp"]
  }
}
